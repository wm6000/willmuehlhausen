{
  "name": "willmuehlhausen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "npm run lint && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "lint": "node scripts/check-structure.mjs && node scripts/parity.mjs && tsc --noEmit -p config/tsconfig.json && eslint . --config config/eslint.config.mjs",
    "structure": "node scripts/check-structure.mjs",
    "eslint": "eslint . --config config/eslint.config.mjs",
    "parity": "node scripts/parity.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6"
  }
}
